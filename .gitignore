# Python compiled files
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
env/
venv/
driver_env/
.Python

# VS Code settings
.vscode/

# Mac OS files
.DS_Store

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Large models (handled by Git LFS)
*.h5
*.pt

# Local secrets and tool caches
.env
.pytest_cache/

# Generated training data and run outputs (rebuild with python -m training.prepare_dataset)
data/processed/*/images/
models/*/runs/

# Local database backups (contain password hashes and personal data)
instance/backups/
# Development email outbox (contains one-time codes)
instance/dev_outbox/
# Independent model-evaluation reports (pseudonymous subject ids; scripts/evaluate_independent_faces.py)
instance/evaluations/
# Development-only Flask secret (generated locally; production must set SAFEDRIVE_SECRET_KEY)
instance/.dev_secret_key

.venv/
.env
