# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
SAFEDRIVE_ENV=development            # development | production | testing
SAFEDRIVE_SECRET_KEY=                # python -c "import secrets; print(secrets.token_hex(32))"
SAFEDRIVE_DEBUG=0
SAFEDRIVE_SESSION_COOKIE_SECURE=0    # 1 when served over HTTPS

SAFEDRIVE_DB_HOST=localhost
SAFEDRIVE_DB_PORT=3306
SAFEDRIVE_DB_USER=safedrive          # use a dedicated MySQL user, not root
SAFEDRIVE_DB_PASSWORD=
SAFEDRIVE_DB_NAME=safedrive_ai_v2

# Camera engine
SAFEDRIVE_CAMERA_SOURCE=0
SAFEDRIVE_YOLO_WEIGHTS=yolov8n.pt
MODEL_PROVIDER=alcohol_mobilenetv3   # alcohol_mobilenetv3 (default) | none | mock (development only)
ALCOHOL_MODEL_PATH=models/alcohol_mobilenetv3/model.pt

# Assistance workflow (matching works without any map provider)
ASSISTANCE_SEARCH_RADII_KM=5,15,50   # radius widens step by step when nobody accepts
ASSISTANCE_OFFERS_PER_ROUND=3        # Umusare notified per round; first to accept wins
ASSISTANCE_OFFER_TIMEOUT_S=90        # unanswered offers expire, then the next round runs
UMUSARE_LOCATION_MAX_AGE_S=1800      # an available Umusare must have shared a position this recently
ASSISTANCE_ETA_SPEED_KMH=25          # assumed urban speed for the arrival estimate shown to drivers
# Live maps: Leaflet with a configurable tile provider (default CARTO Voyager; set CARTO_API_KEY in .env). Navigation links open Google Maps.
# The public tile.openstreetmap.org servers must not be used by apps (they return 403). Example with a key:
#   MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key={key}
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
MAP_TILE_SUBDOMAINS=
MAP_TILE_MAX_ZOOM=
MAP_TILE_API_KEY=                    # substituted for {key}; never commit real keys
CARTO_API_KEY=                       # CARTO Basemaps key, added as ?key=... to CARTO tile URLs (keep real key in .env only)
GOOGLE_MAPS_API_KEY=                 # optional, currently unused by the maps

# Optional, for create_admin.py (otherwise it prompts)
SAFEDRIVE_ADMIN_EMAIL=
SAFEDRIVE_ADMIN_PASSWORD=

# ---- Email (OTP verification). Never commit real credentials: put them only in your local .env ----
# SMTP is used only when MAIL_HOST, MAIL_USERNAME and MAIL_PASSWORD are all set. Otherwise development
# writes emails to instance/dev_outbox/ (nothing is sent), tests keep them in memory, and production refuses.
# Gmail: MAIL_HOST=smtp.gmail.com, port 587, STARTTLS, MAIL_PASSWORD = a Google App Password (not the
# normal Gmail password), and MAIL_FROM = the same Gmail address as MAIL_USERNAME.
# Check the configuration with:  python -m website.mailer smtp-test --to you@example.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_FROM=
# MAIL_USE_SSL=false                 (port 465 instead of STARTTLS)
# MAIL_BACKEND=smtp|file|memory      (optional override; production always requires smtp)

# Contact shown on the Terms / Privacy pages, and registrations allowed per IP address per hour
SAFEDRIVE_CONTACT_EMAIL=fabricendayisaba16@gmail.com
REGISTRATION_LIMIT_PER_HOUR=10
